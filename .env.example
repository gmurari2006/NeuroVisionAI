# ==============================================================================
# NeuroVisionAI - Environment Configuration Template (.env.example)
# Copy this file to .env (or configure in your cloud host dashboard)
# IMPORTANT: Placeholders only. NEVER commit real production secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FastAPI Backend Configuration (e.g. Render, Railway, Fly.io, AWS ECS, Docker)
# ------------------------------------------------------------------------------
# Network interface to bind to (use 0.0.0.0 in cloud containers, 127.0.0.1 for local isolation)
HOST=0.0.0.0

# HTTP listen port (standardly injected by Render / cloud platforms as PORT)
PORT=8000

# Permitted CORS Origins (comma-separated list of allowed frontend domains)
# Example: https://neurovision-ai.vercel.app,http://localhost:3000
CORS_ORIGINS=https://neurovision-ai.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Regex pattern for dynamic production/preview domains (matches all Vercel preview branches)
# Default: ^https://.*\.vercel\.app$
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Models to load into memory: "resnet50,vgg16" (or "resnet50" for 512MB RAM free tier)
LOAD_MODELS=resnet50,vgg16

# Optional: Path to custom models directory (e.g. Render persistent disk: /var/data/models)
# MODELS_DIR=/var/data/models

# Optional: Direct checkpoint file paths if stored in custom paths
# RESNET_MODEL_PATH=/var/data/models/resnet50_finetuned_best.pth
# VGG_MODEL_PATH=/var/data/models/vgg16_best.pth

# Optional: Cloud storage URLs to auto-download checkpoints during deployment startup
# RESNET_WEIGHTS_URL=https://huggingface.co/.../resnet50_finetuned_best.pth
# VGG_WEIGHTS_URL=https://huggingface.co/.../vgg16_best.pth

# ------------------------------------------------------------------------------
# 2. Next.js Frontend Configuration (e.g. Vercel, AWS Amplify, Docker)
# ------------------------------------------------------------------------------
# Server-side rewrite destination used by Next.js next.config.mjs to proxy /api/* requests
# Configure this in your Vercel Project Settings -> Environment Variables.
# The value is never exposed to the browser client bundle.
# Example: https://neurovision-ai-backend.onrender.com or http://127.0.0.1:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# (Optional) Public API URL if client browser calls backend directly instead of via Next.js proxy
# Direct mode bypasses Vercel's 4.5 MB serverless function payload limit for 15 MB scans.
# Example: https://neurovision-ai-backend.onrender.com
NEXT_PUBLIC_API_URL=
