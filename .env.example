# ==============================================================================
# NeuroVisionAI - Environment Configuration Template (.env.example)
# Copy this file to .env (or configure in your cloud host dashboard)
# IMPORTANT: Placeholders only. NEVER commit real production secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FastAPI Backend Configuration (e.g. Railway, Render, Fly.io, AWS ECS, Docker)
# ------------------------------------------------------------------------------
# Network interface to bind to (use 0.0.0.0 in cloud containers, 127.0.0.1 for local isolation)
HOST=0.0.0.0

# HTTP listen port (standardly injected by cloud platforms as PORT)
PORT=8000

# Permitted CORS Origins (comma-separated list of allowed frontend domains)
# Example: https://neurovision-ai.vercel.app,http://localhost:3000
CORS_ORIGINS=https://neurovision-ai.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. Next.js Frontend Configuration (e.g. Vercel, AWS Amplify, Docker)
# ------------------------------------------------------------------------------
# Internal/Server-side rewrite destination used by Next.js next.config.mjs to proxy /api/* requests
# Configure this in your Vercel Project Settings -> Environment Variables.
# The value is never exposed to the browser client bundle.
# Example: https://api.neurovision.yourdomain.com or http://backend-service:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# (Optional) Public API URL if client browser calls backend directly instead of via Next.js proxy
# Leave unset to enable the recommended zero-CORS relative Next.js rewrite proxy (/api/*)
# Example: https://api.neurovision.yourdomain.com
NEXT_PUBLIC_API_URL=
