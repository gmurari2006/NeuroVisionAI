# ==============================================================================
# NeuroVisionAI - Next.js Frontend Environment Template (frontend/.env.example)
# Configure these variables in Vercel Project Settings -> Environment Variables.
# ==============================================================================

# Option A (Recommended for standard workloads): Server-side Next.js Rewrites
# Points to your FastAPI backend (e.g. Render: https://neurovision-ai-backend.onrender.com)
# The browser talks only to same-origin /api/* (Zero CORS friction).
# Note: Subject to Vercel's 4.5 MB serverless body size ceiling.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Option B: Direct Browser-to-Backend Mode (Recommended for large 15 MB scans)
# Points directly to your externally hosted FastAPI backend (e.g. Render)
# Enables the browser to POST large MRI images directly to FastAPI, bypassing Vercel's 4.5 MB limit.
# FastAPI CORS is pre-configured with CORS_ORIGIN_REGEX to accept all Vercel domains.
# Example: https://neurovision-ai-backend.onrender.com
NEXT_PUBLIC_API_URL=
