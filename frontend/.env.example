# ==============================================================================
# NeuroVisionAI - Next.js Frontend Environment Template (frontend/.env.example)
# Configure these variables in Vercel Project Settings -> Environment Variables.
# ==============================================================================

# Server-side backend destination for Next.js rewrites (never exposed to browser)
# Points to your externally hosted FastAPI backend (e.g. on Render, Railway, AWS ECS)
# In local development, defaults to: http://127.0.0.1:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# (Optional) Public backend URL for direct client-side browser requests
# Leave empty to use the recommended Next.js /api rewrite proxy (avoids CORS)
NEXT_PUBLIC_API_URL=
